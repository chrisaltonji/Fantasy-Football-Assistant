# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# These two cookies are only needed for PRIVATE leagues. Public leagues work
# without them. See README.md for how to pull them out of your browser.
#
# Both are session credentials tied to your ESPN login. Treat them like a
# password: anyone holding them can act as you on ESPN Fantasy.

ESPN_S2=
ESPN_SWID=

# Optional: lets the probe and `ffa config init` run without --league-id/--year.
ESPN_LEAGUE_ID=
ESPN_SEASON_YEAR=

# Optional: the inference layer (`ffa draft --assist`). Everything the tool
# asserts is arithmetic over the journal and is exact without this — the key
# buys judgement on top, never a number underneath.
#
# Get one at https://console.anthropic.com -> API keys. It starts with sk-ant-.
# No quotes and no surrounding spaces needed; both are tolerated if you add them.
ANTHROPIC_API_KEY=

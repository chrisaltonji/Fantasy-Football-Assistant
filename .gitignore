# --- Secrets. Never commit ESPN session cookies. ---
.env
.env.local
*.pem

# --- Live config (contains your league id; generated by `ffa config init`) ---
config/league.toml

# --- Your private reference data (rankings, auction values, projections) ---
data/reference/*
!data/reference/.gitkeep

# --- Candid written opinions about twelve real people you know. ---
# The form and the chat brief are the same content in prose.
data/dossiers.json
docs/dossier_form.md
docs/dossier_brief.md
docs/dossier_suggested.json

# --- Six years of who paid what for whom, with names attached. ---
docs/draft_history.html
data/manager_precedent.json

# --- Draft run journals ---
runs/

# --- Captured ESPN payloads from tools/espn_probe.py ---
# Scrubbed fixtures under tests/fixtures/espn/ ARE committed on purpose.
probe_out/

# --- Browser network captures. A HAR carries live espn_s2/SWID cookies. ---
*.har

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store

# --- Local preview leftovers from browser screenshots ---
.playwright-mcp/
/status-*.png

# --- Design bundle: kept on disk exactly as delivered, not published. ---
# The mockup renders with the real league name, the owner's name and six real
# manager nicknames. They are display strings rather than credentials, but this
# repo is public and that is the same category as the sample payloads. Delete
# these two lines to publish it.
docs/design_handoff_draft_board/
docs/Dashboard UI mockups.zip
